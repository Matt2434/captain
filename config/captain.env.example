# Copy to config/captain.env and fill in. install.sh replaces the __PLACEHOLDERS__ in the skill and scripts.
# Never put tokens or passwords in this file; they go in your project's .env (chmod 600) or the macOS Keychain.

PROJECT_DIR="$HOME/Desktop/Capstone"          # your project folder (Captain starts here)
GH_USER="your-school-github-login"           # school-only GitHub account
GH_REPO="Org/Team-Repo"                      # team repository
REPO_CHECKOUT="team-repo-checkout"           # folder name of a checkout inside PROJECT_DIR (for cmux PR badges)

SCHOOL_USER="netid"                          # school username (VPN, VM, YouTrack login)
SCHOOL_EMAIL="netid@school.edu"

VM_HOST="10.0.0.10"                          # team VM / CI host (leave empty if none)
VM_HOSTNAME="team-vm"                        # what the VM prompt shows after user@

YOUTRACK_URL="https://yourteam.myjetbrains.com/youtrack"
YOUTRACK_PROJECT="01A"

SP_HOST="school.sharepoint.com"
SP_SITE_NAME="Your-Team-Site"                # /sites/<this>
YOUR_FOLDER="YOUR NAME"                      # your DRAFTS subfolder
TEAMS_GROUP_CHAT="Team Chat Name"            # Teams group chat used for review messages

VPN_PROFILE="STUDENT"                        # Cisco Secure Client profile name
VPN_KEYCHAIN_ITEM="school-vpn"               # Keychain item holding the VPN password
